{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "telnyx.error.schema.json",
  "title": "Telnyx: error response",
  "type": "object",
  "required": [
    "errors"
  ],
  "properties": {
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "title",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{5}$"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "required": [
              "pointer"
            ],
            "properties": {
              "pointer": {
                "type": "string",
                "pattern": "^/"
              }
            }
          }
        }
      }
    }
  }
}
