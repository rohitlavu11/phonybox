{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "telnyx.message.schema.json",
  "title": "Telnyx: message record (POST/GET /v2/messages, message.* payloads)",
  "type": "object",
  "required": [
    "record_type",
    "direction",
    "id",
    "type",
    "messaging_profile_id",
    "from",
    "to",
    "text",
    "media",
    "encoding",
    "parts",
    "errors",
    "received_at",
    "sent_at",
    "completed_at"
  ],
  "properties": {
    "record_type": {
      "const": "message"
    },
    "direction": {
      "enum": [
        "outbound",
        "inbound"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {
      "enum": [
        "SMS",
        "MMS"
      ]
    },
    "from": {
      "type": "object",
      "required": [
        "phone_number",
        "carrier",
        "line_type"
      ],
      "properties": {
        "phone_number": {
          "type": "string",
          "pattern": "^\\+[1-9]\\d{7,14}$"
        }
      }
    },
    "to": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "phone_number",
          "status"
        ],
        "properties": {
          "phone_number": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{7,14}$"
          },
          "status": {
            "enum": [
              "queued",
              "sending",
              "sent",
              "delivered",
              "sending_failed",
              "delivery_failed",
              "delivery_unconfirmed",
              "webhook_delivered"
            ]
          }
        }
      }
    },
    "text": {
      "type": "string"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "content_type"
        ]
      }
    },
    "encoding": {
      "enum": [
        "GSM-7",
        "UCS-2"
      ]
    },
    "parts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "title"
        ]
      }
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
